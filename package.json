{
  "name": "@onpeek/nuvio",
  "version": "1.0.0",
  "description": "CLI and agent skill for managing a Nuvio account.",
  "type": "module",
  "license": "MIT",
  "author": "onpeek",
  "homepage": "https://github.com/onpeek/nuvio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onpeek/nuvio.git"
  },
  "bugs": {
    "url": "https://github.com/onpeek/nuvio/issues"
  },
  "keywords": [
    "nuvio",
    "cli",
    "agent-skill",
    "stremio",
    "addons"
  ],
  "bin": {
    "nuvio": "dist/index.js"
  },
  "files": [
    "dist",
    "skills/nuvio"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/cli.test.mjs test/unit.test.mjs test/refactor.test.mjs"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
